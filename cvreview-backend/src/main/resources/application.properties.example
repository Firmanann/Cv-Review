spring.application.name=cvreview

# Database PostgreSQL
spring.datasource.url=jdbc:postgresql://${DB_HOST:localhost}:${DB_PORT:5432}/${DB_NAME:cvreview_db}
spring.datasource.username=${DB_USER:postgres}
spring.datasource.password=${DB_PASSWORD:your_db_password_here}
spring.datasource.driver-class-name=org.postgresql.Driver

# JPA / Hibernate
spring.jpa.hibernate.ddl-auto=validate
spring.jpa.show-sql=false
spring.jpa.properties.hibernate.format_sql=true
spring.jpa.open-in-view=false

# Flyway Migration
spring.flyway.enabled=true
spring.flyway.baseline-on-migrate=true
spring.flyway.locations=classpath:db/migration

# JWT Configuration (Secret Key 256-bit & Expiration 24 Jam)
jwt.secret=YOUR_256_BIT_SECRET_KEY_HERE
jwt.expiration=86400000

# Redis
spring.data.redis.host=${REDIS_HOST:localhost}
spring.data.redis.port=${REDIS_PORT:6380}
spring.data.redis.password=${REDIS_PASSWORD:your_redis_password_here}
spring.data.redis.timeout=2000ms

# Groq AI Configuration
ai.api.key=YOUR_GROQ_API_KEY_HERE
ai.api.url=https://api.groq.com/openai/v1/chat/completions
ai.api.model=llama-3.3-70b-versatile

# Configuration parsing
ats.rules.heading-whitelist=EXPERIENCE,EDUCATION,SKILLS,SUMMARY,CERTIFICATIONS
ats.rules.font-whitelist=Arial,Calibri,Times New Roman,Georgia

# Rules Threshold
ats.rules.min-text-length=200
ats.rules.keyword-density-min=2
ats.rules.keyword-density-max=3

# Scoring Weights
ats.rules.weight-parsing=0.4
ats.rules.weight-keyword=0.4
ats.rules.weight-completeness=0.2
