spring.application.name=cvreview

server.port=8080
spring.servlet.multipart.max-file-size=5MB
spring.servlet.multipart.max-request-size=6MB

# Redis
spring.data.redis.host=${REDIS_HOST:localhost}
spring.data.redis.port=${REDIS_PORT:6380}
spring.data.redis.password=${REDIS_PASSWORD:redismann}
spring.data.redis.timeout=2000ms

# Groq API Configuration
ai.api.key=${GROQ_API_KEY:YOUR_GROQ_API_KEY_HERE}
ai.api.url=https://api.groq.com/openai/v1/chat/completions
ai.api.model=${GROQ_MODEL:openai/gpt-oss-20b}

# Configuration parsing
ats.rules.heading-whitelist=EXPERIENCE,EDUCATION,SKILLS,SUMMARY,CERTIFICATIONS
ats.rules.font-whitelist=Arial,Calibri,Times New Roman,Georgia

# Rules Threshold
ats.rules.min-text-length=200
ats.rules.keyword-density-min=2
ats.rules.keyword-density-max=3

# Scoring Weights
ats.rules.weight-parsing=0.4
ats.rules.weight-keyword=0.4
ats.rules.weight-completeness=0.2
